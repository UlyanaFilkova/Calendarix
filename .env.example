# Telegram bot token from @BotFather
BOT_TOKEN=токен_от_BotFather

# PostgreSQL connection string
DATABASE_URL=postgresql://calendarix:password@postgres:5432/calendarix

# RabbitMQ connection string
RABBITMQ_URL=amqp://calendarix:password@rabbitmq:5672/

# Parser Service: Telegram API credentials (my.telegram.org)
TG_API_ID=твой_api_id
TG_API_HASH=твой_api_hash
TG_PHONE=+79001234567

# Parser Service: OpenAI API key
OPENAI_API_KEY=sk-твой_ключ
