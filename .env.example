# Telegram bot token from @BotFather
BOT_TOKEN=токен_от_BotFather

# PostgreSQL connection string
DATABASE_URL=postgresql://calendarix:password@postgres:5432/calendarix

# RabbitMQ connection string
RABBITMQ_URL=amqp://calendarix:password@rabbitmq:5672/

# Parser Service: Cloudflare Workers AI (dash.cloudflare.com) — бесплатно ~10K запросов/день
# Token: My Profile → API Tokens → Create → Workers AI. Account ID: дашборд → Overview (справа снизу)
LLM_API_KEY=твой_cloudflare_token
LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/твой_account_id/ai/v1/
LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
